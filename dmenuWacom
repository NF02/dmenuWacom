if ! command -v wofi &> /dev/null; then
    echo "Errore: Wofi non è installato. Installalo con il tuo gestore di pacchetti."
    exit 1
fi

if [[ $XDG_CURRENT_DESKTOP == "Hyprland" ]]; then
    WM="hyprland"
elif [[ $XDG_CURRENT_DESKTOP == "sway" ]]; then
    WM="sway"
else
    notify-send "Error: This script only supports Hyprland or Sway."
    exit 1
fi

PAD=$(libinput list-devices | grep -i 'Tablet' | awk -F 'Device:' '{print $2}' | head -n 1 | xargs)


if [[ $1 == --version ]] || [[ $1 == -v ]] || [[ $1 == -VERSION ]]; then
	cat << 'EOF'
╺┳┓┏┳┓╻ ╻┏━┓┏━╸┏━┓┏┳┓   ┏━┓ ┏━╸   ┏┓ ┏━╸╺┳╸┏━┓
 ┃┃┃┃┃┃╻┃┣━┫┃  ┃ ┃┃┃┃   ┃┃┃ ┗━┓   ┣┻┓┣╸  ┃ ┣━┫
╺┻┛╹ ╹┗┻┛╹ ╹┗━╸┗━┛╹ ╹   ┗━┛╹┗━┛   ┗━┛┗━╸ ╹ ╹ ╹
EOF
	exit 0
fi

if [[ $PAD == "" ]]; then
	notify-send "💀 Pad not found"
	exit 1
fi

if [[ $1 == --clear ]] || [[ $1 == -c ]] || [[ $1 == -CLEAR ]]; then
	echo "" > dmw_history
	exit 0
fi

# Funzione per ruotare la tavoletta
rotate_tablet() {
    ROTATION=$(echo -e "normal\ninverted\nleft\nright" | wofi --dmenu --prompt "Select rotation:")
    case $ROTATION in
        normal)   transform="0" ;;
        inverted) transform="180" ;;
        left)     transform="90" ;;
        right)    transform="270" ;;
        *) exit 1 ;;
    esac

    if [[ $WM == "hyprland" ]]; then
        hyprctl keyword device:${PAD},transform,${transform}
    elif [[ $WM == "sway" ]]; then
        swaymsg input "${PAD}" transform ${transform}
    fi
}

# Funzione per mappare la tavoletta a un monitor specifico
map_to_monitor() {
    # Ottiene l'elenco dei monitor disponibili
    if [[ $WM == "hyprland" ]]; then
        MONITORS=$(hyprctl monitors | grep "Monitor" | awk '{print $2}')
    elif [[ $WM == "sway" ]]; then
        MONITORS=$(swaymsg -t get_outputs | jq -r '.[].name')
    fi

    # Seleziona il monitor tramite Wofi
    MONITOR=$(echo -e "$MONITORS" | wofi --dmenu --prompt "Select monitor:")
    if [ -z "$MONITOR" ]; then exit 1; fi

    if [[ $WM == "hyprland" ]]; then
        hyprctl keyword device:${PAD},mapto,${MONITOR}
    elif [[ $WM == "sway" ]]; then
        swaymsg input "${PAD}" map_to_output ${MONITOR}
    fi
}

# Funzione per impostare la modalità della tavoletta
set_mode() {
    MODE=$(echo -e "absolute\nrelative" | wofi --dmenu --prompt "Select mode:")
    case $MODE in
        absolute) mode_value="absolute" ;;
        relative) mode_value="relative" ;;
        *) exit 1 ;;
    esac

    if [[ $WM == "hyprland" ]]; then
        hyprctl keyword device:${PAD},mode,${mode_value}
    elif [[ $WM == "sway" ]]; then
        swaymsg input "${PAD}" event ${mode_value}
    fi
}

# Menu principale con Wofi
main_menu() {
    CHOICE=$(echo -e "Rotate tablet\nMap to monitor\nSet mode" | wofi --dmenu --prompt "Select an action:")
    case $CHOICE in
        "Rotate tablet") rotate_tablet ;;
        "Map to monitor") map_to_monitor ;;
        "Set mode") set_mode ;;
        *) exit 1 ;;
    esac
}

# Avvia il menu principale
main_menu
