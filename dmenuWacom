if ! command -v wofi &> /dev/null; then
    echo "Errore: Wofi non è installato. Installalo con il tuo gestore di pacchetti."
    exit 1
fi

if [[ $XDG_CURRENT_DESKTOP == "Hyprland" ]]; then
    WM="hyprland"
elif [[ $XDG_CURRENT_DESKTOP == "sway" ]]; then
    WM="sway"
else
    notify-send "Error: This script only supports Hyprland or Sway."
    exit 1
fi

PAD=$(libinput list-devices | grep -i 'Tablet' | awk -F 'Device:' '{print $2}' | head -n 1 | xargs)
TABLET_KEYS=$(libinput list-devices | grep -i 'Tablet' | grep -i 'keyboard' | awk -F 'Device:' '{print $2}' | xargs)



if [[ $1 == --version ]] || [[ $1 == -v ]] || [[ $1 == -VERSION ]]; then
	cat << 'EOF'
╺┳┓┏┳┓╻ ╻┏━┓┏━╸┏━┓┏┳┓   ┏━┓ ┏━╸   ┏┓ ┏━╸╺┳╸┏━┓
 ┃┃┃┃┃┃╻┃┣━┫┃  ┃ ┃┃┃┃   ┃┃┃ ┗━┓   ┣┻┓┣╸  ┃ ┣━┫
╺┻┛╹ ╹┗┻┛╹ ╹┗━╸┗━┛╹ ╹   ┗━┛╹┗━┛   ┗━┛┗━╸ ╹ ╹ ╹
EOF
	exit 0
fi

if [[ $PAD == "" ]]; then
	notify-send "💀 Pad not found"
	exit 1
fi

if [[ $1 == --clear ]] || [[ $1 == -c ]] || [[ $1 == -CLEAR ]]; then
	echo "" > dmw_history
	exit 0
fi

# Function to rotate the tablet
rotate_tablet() {
    ROTATION=$(echo -e "normal\ninverted\nleft\nright" | wofi --dmenu --prompt "Select rotation:")
    case $ROTATION in
        normal)   transform="0" ;;
        inverted) transform="180" ;;
        left)     transform="90" ;;
        right)    transform="270" ;;
        *) exit 1 ;;
    esac

    if [[ $WM == "hyprland" ]]; then
        hyprctl keyword device:${PAD},transform,${transform}
    elif [[ $WM == "sway" ]]; then
        swaymsg input "${PAD}" transform ${transform}
    fi
}

# Function to map the tablet to a specific monitor
map_to_monitor() {
    # Ottiene l'elenco dei monitor disponibili
    if [[ $WM == "hyprland" ]]; then
        MONITORS=$(hyprctl monitors | grep "Monitor" | awk '{print $2}')
    elif [[ $WM == "sway" ]]; then
        MONITORS=$(swaymsg -t get_outputs | jq -r '.[].name')
    fi

    # Seleziona il monitor tramite Wofi
    MONITOR=$(echo -e "$MONITORS" | wofi --dmenu --prompt "Select monitor:")
    if [ -z "$MONITOR" ]; then exit 1; fi

    if [[ $WM == "hyprland" ]]; then
        hyprctl keyword device:${PAD},mapto,${MONITOR}
    elif [[ $WM == "sway" ]]; then
        swaymsg input "${PAD}" map_to_output ${MONITOR}
    fi
}

# Function to set the tablet mode
set_mode() {
    MODE=$(echo -e "absolute\nrelative" | wofi --dmenu --prompt "Select mode:")
    case $MODE in
        absolute) mode_value="absolute" ;;
        relative) mode_value="relative" ;;
        *) exit 1 ;;
    esac

    if [[ $WM == "hyprland" ]]; then
        hyprctl keyword device:${PAD},mode,${mode_value}
    elif [[ $WM == "sway" ]]; then
        swaymsg input "${PAD}" event ${mode_value}
    fi
}

# Function to configure the tablet keys
configure_keys() {
    if [ -z "$KEYS" ]; then
        echo "Nessun tasto configurabile trovato sulla tavoletta."
        exit 1
    fi

    # List of customizable keys
    KEY_CHOICES="Key1\nKey2\nKey3\nKey4\nKey5\nKey6\nKey7\nKey8"
    SELECTED_KEY=$(echo -e "$KEY_CHOICES" | wofi --dmenu --prompt "Seleziona un tasto:")
    if [ -z "$SELECTED_KEY" ]; then exit 1; fi

    # Select the action to associate
    ACTION=$(echo -e "Ctrl+Z\nCtrl+Y\nCtrl+S\nCtrl+C\nCtrl+V\nSuper+E\nCustom" | wofi --dmenu --prompt "Assegna un'azione:")
    if [ -z "$ACTION" ]; then exit 1; fi

    # Se l'utente seleziona "Custom", permette di inserire un comando personalizzato
    if [[ "$ACTION" == "Custom" ]]; then
        ACTION=$(wofi --dmenu --prompt "Inserisci comando personalizzato:")
        if [ -z "$ACTION" ]; then exit 1; fi
    fi

    # Configure the key with `swaymsg` or `hyprctl`
    if [[ $WM == "hyprland" ]]; then
        hyprctl keyword device:${TABLET_KEYS},bind,${SELECTED_KEY},exec,${ACTION}
    elif [[ $WM == "sway" ]]; then
        swaymsg "bindsym ${SELECTED_KEY} exec ${ACTION}"
    fi

    echo "${SELECTED_KEY} key configured with action: ${ACTION}"
}

# Main menu with Wofi
main_menu() {
    CHOICE=$(echo -e "Rotate tablet\nMap to monitor\nSet mode" | wofi --dmenu --prompt "Select an action:")
    case $CHOICE in
        "Rotate tablet") rotate_tablet ;;
        "Map to monitor") map_to_monitor ;;
        "Set mode") set_mode ;;
	"Configure keys") configure_keys ;;
        *) exit 1 ;;
    esac
}

# Start the main menu
main_menu
